build*/
# Git's ignore matching is case-insensitive on Windows, so `build*/` also
# catches the IFC source directory named `Buildings` unless it is re-included.
!weakPacket_decoding/Buildings/
!weakPacket_decoding/Buildings/**
# Keep the locally supplied building model out of commits; generated scene
# metadata records its expected path and the converter can be rerun in place.
weakPacket_decoding/Buildings/**/*.ifc
*.pyc
*.pyo
*.bin
*.cfile
.vscode/
*/__pycache__/*
**/__pycache__/

# Raw IQ captures and temporary analysis artifacts.
data/USRP_IQ/**/*.bin
data/USRP_IQ/**/*.log
examples/_file_source_staging/
examples/_full_debug.log

# Generated weak-packet IQ sweeps.
weakPacket_decoding/data/*.bin
weakPacket_decoding/data/**/*.bin
weakPacket_decoding/_file_source_staging/

# Reproducible weak-packet experiment outputs.
weakPacket_decoding/**/_eval/
weakPacket_decoding/data/ser_comparison_baselines_phase_line_*/
weakPacket_decoding/data/phase_line_error_diagnostics_*/
