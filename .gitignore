weakPacket_decoding/data/experiments/dep_anchor_20261004/m2b_battle_checkpoint.jsonl
weakPacket_decoding/data/experiments/dep_anchor_20261004/m2_battleC_checkpoint.jsonl
weakPacket_decoding/data/experiments/keystone_battle_20261003/*checkpoint*.jsonl
weakPacket_decoding/data/experiments/phase_track_20261002/*.jsonl
weakPacket_decoding/data/experiments/g1_rescue_map_20261004/*.jsonl
weakPacket_decoding/data/experiments/fullfield_cert_detect_20261003/checkpoint*.jsonl
weakPacket_decoding/paper/
*.jsonl.bak
