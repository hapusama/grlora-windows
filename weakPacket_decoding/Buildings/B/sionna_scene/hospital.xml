<scene version="2.1.0">

    <!-- Radio materials -->
    <bsdf type="radio-material" id="mat-custom-concrete">
        <float name="relative_permittivity" value="5.24"/>
        <float name="conductivity" value="0.02634602265748256"/>
        <float name="thickness" value="0.16"/>
        <float name="scattering_coefficient" value="0.0"/>
        <rgb name="color" value="0.6, 0.62, 0.65"/>
    </bsdf>

    <bsdf type="radio-material" id="mat-custom-wood">
        <float name="relative_permittivity" value="1.99"/>
        <float name="conductivity" value="0.0021770077814599886"/>
        <float name="thickness" value="0.04"/>
        <float name="scattering_coefficient" value="0.0"/>
        <rgb name="color" value="0.55, 0.36, 0.2"/>
    </bsdf>

    <bsdf type="radio-material" id="mat-custom-glass">
        <float name="relative_permittivity" value="6.31"/>
        <float name="conductivity" value="0.001375986907482911"/>
        <float name="thickness" value="0.008"/>
        <float name="scattering_coefficient" value="0.0"/>
        <rgb name="color" value="0.35, 0.65, 0.85"/>
    </bsdf>

    <!-- IFC geometry merged by radio material -->
    <shape type="ply" id="mesh-concrete">
        <string name="filename" value="meshes/concrete.ply"/>
        <boolean name="face_normals" value="true"/>
        <ref id="mat-custom-concrete" name="bsdf"/>
    </shape>

    <shape type="ply" id="mesh-glass">
        <string name="filename" value="meshes/glass.ply"/>
        <boolean name="face_normals" value="true"/>
        <ref id="mat-custom-glass" name="bsdf"/>
    </shape>

    <shape type="ply" id="mesh-wood">
        <string name="filename" value="meshes/wood.ply"/>
        <boolean name="face_normals" value="true"/>
        <ref id="mat-custom-wood" name="bsdf"/>
    </shape>

</scene>
